generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  passwordUpdatedAt DateTime?
  otpSecret         String?
  pendingOtpSecret  String?
  createdAt         DateTime        @default(now())

  passwordReset     PasswordReset?

  @@map("admins")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  adminId   String   @unique
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// Contact unique par email — regroupe toutes les conversations
model Contact {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  ContactMessage[]

  @@map("contacts")
}

model ContactMessage {
  id          String         @id @default(cuid())
  email       String         @default("")
  subject     String         @default("")
  message     String
  attachments Json           @default("[]")
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  replies     MessageReply[]

  contactId   String
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("contact_messages")
}

model MessageReply {
  id          String         @id @default(cuid())
  message     String
  attachments Json           @default("[]")
  createdAt   DateTime       @default(now())

  contactMessageId String
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@map("message_replies")
}

// Projets affichés sur le portfolio
model Project {
  id          String         @id @default(cuid())
  title       String
  description String
  gradient    String         @default("from-brand-400/20 to-brand-600/20")
  link        String?
  github      String?
  order             Int            @default(0)
  visible           Boolean        @default(true)
  useGradientBanner Boolean        @default(false)
  skills            ProjectSkill[]
  images            ProjectImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("projects")
}

model ProjectSkill {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  color     String  @default("#00D5BE")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_skills")
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  public_id String
  order     Int     @default(0)
  
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model Cv {
  id            String   @id @default(cuid())
  url           String
  public_id     String
  resource_type String   @default("image")
  size          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cvs")
}

// Section « À propos » — singleton
model AboutMe {
  id        String        @id @default(cuid())
  bio       String        @default("")
  stats     Json          @default("[]")
  techs     AboutMeTech[]
  updatedAt DateTime      @updatedAt

  @@map("about_me")
}

model AboutMeTech {
  id    String  @id @default(cuid())
  name  String
  icon  String?
  color String  @default("#00D5BE")
  order Int     @default(0)

  aboutMeId String
  aboutMe   AboutMe @relation(fields: [aboutMeId], references: [id], onDelete: Cascade)

  @@map("about_me_techs")
}

// Rate limiting — serverless-compatible via shared PostgreSQL
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}