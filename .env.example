# ─── Auth ────────────────────────────────────────────────
AUTH_SECRET="your-auth-secret-here"
AUTH_TRUST_HOST="true"
AUTH_URL="your-auth-url"

# ─── Cloudinary ──────────────────────────────────────────
CLOUDINARY_FOLDER="your-cloudinary-folder"
CLOUDINARY_URL="your-cloudinary-url"

# ─── Email (contact form destination) ────────────────────
CONTACT_NOTIFICATION_EMAIL="admin@example.com"

# ─── Database ────────────────────────────────────────────
DATABASE_URL="your-database-url"
DIRECT_DATABASE_URL="your-direct-database-url"

# ─── Doppler ─────────────────────────────────────────────
DOPPLER_CONFIG="your-doppler-config"
DOPPLER_ENVIRONMENT="your-doppler-env"
DOPPLER_PROJECT="your-doppler-project"

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="your-app-url"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-umami-website-id"
NEXT_TELEMETRY_DISABLED="1"

# ─── Security ────────────────────────────────────────────
OTP_ENCRYPTION_KEY="your-otp-encryption-key"

# ─── Email transport ────────────────────────────────────
# Resend SDK (production/staging)
RESEND_API_KEY="re_your-resend-api-key"

# SMTP (local dev via Mailpit)
SMTP_FROM="Portfolio <contact@example.com>"
SMTP_HOST="mailpit"
SMTP_PASS="none"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="none"

# ─── Analytics ───────────────────────────────────────────
UMAMI_API_KEY="your-umami-api-key"
UMAMI_API_URL="your-umami-api-url"